# ===== Database =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=laptop_marketplace
DATABASE_URL=postgresql://postgres:postgres@db:5432/laptop_marketplace

# ===== JWT =====
JWT_SECRET=supersecretkey
JWT_EXPIRES_IN=7d

# ===== Rate Limiting =====
# Development: 500. Production: 20.
AUTH_RATE_LIMIT=500

# ===== Admin IP Restriction =====
# Development: allow localhost + private ranges.
ADMIN_ALLOWED_IPS=127.0.0.1,::1,::ffff:127.0.0.1

# ===== Service URLs (internal Docker network) =====
AUTH_SERVICE_URL=http://auth-service:5001
CATALOG_SERVICE_URL=http://catalog-service:5002
INVENTORY_SERVICE_URL=http://inventory-service:5003
RECOMMENDATION_SERVICE_URL=http://recommendation-service:5004
NOTIFICATION_SERVICE_URL=http://notification-service:5005
LOCATION_SERVICE_URL=http://location-service:5006

# ===== Frontend =====
VITE_API_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000

# ===== Environment =====
NODE_ENV=development
