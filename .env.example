# =====================================================
# Laptop Marketplace - Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit the .env file.
# =====================================================

# ===== Database =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=laptop_marketplace
DATABASE_URL=postgresql://postgres:postgres@db:5432/laptop_marketplace

# ===== JWT Authentication =====
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_EXPIRES_IN=7d

# ===== Service URLs (Docker internal network) =====
CATALOG_SERVICE_URL=http://catalog-service:5002
RECOMMENDATION_SERVICE_URL=http://recommendation-service:5004
INVENTORY_SERVICE_URL=http://inventory-service:5003
AUTH_SERVICE_URL=http://auth-service:5001
NOTIFICATION_SERVICE_URL=http://notification-service:5005
LOCATION_SERVICE_URL=http://location-service:5006

# ===== Admin Access Restriction =====
# Comma-separated list of allowed IPs
ADMIN_ALLOWED_IPS=127.0.0.1,::1

# ===== Twilio / WhatsApp (optional) =====
# Leave blank to use simulated mode
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# ===== Frontend =====
VITE_API_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000

# ===== Logging =====
LOG_LEVEL=info

# ===== Service Ports =====
API_GATEWAY_PORT=5000
AUTH_SERVICE_PORT=5001
CATALOG_SERVICE_PORT=5002
INVENTORY_SERVICE_PORT=5003
RECOMMENDATION_SERVICE_PORT=5004
NOTIFICATION_SERVICE_PORT=5005
LOCATION_SERVICE_PORT=5006
